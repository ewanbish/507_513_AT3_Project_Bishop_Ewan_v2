<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE bookings [ <!ELEMENT bookings (booking*)>
<!ATTLIST bookings export-date CDATA "0000-00-00">
<!ELEMENT booking ( date, activity-name, start-time, end-time, trainer, location-name)>
<!ELEMENT date (#PCDATA)>
<!ELEMENT start-time (#PCDATA)>
<!ELEMENT end-time (#PCDATA)>
<!ELEMENT activity-name (#PCDATA)>
<!ELEMENT location-name (#PCDATA)>
<!ELEMENT trainer (name, email)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT email (#PCDATA)>

]>

<bookings export-date="sample_date">
  <booking>
    <date>sample_date</date>
    <activity-name>sample_activity</activity-name>
    <start-time>sample_start</start-time>
    <end-time>sample_end</end-time>
    <trainer>
      <name>
       John Doe
      </name>
      <email>jdoe@gmail.com</email>
    </trainer>
    <location-name>sample_location</location-name>
  </booking>
</bookings>
