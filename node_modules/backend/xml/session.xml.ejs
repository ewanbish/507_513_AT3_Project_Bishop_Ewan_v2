<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE sessions [ <!ELEMENT sessions (session*)>
<!ATTLIST sessions export-date CDATA "0000-00-00">
<!ELEMENT session (date, activity-name, start-time, end-time, trainer, location-name)>
<!ELEMENT id (#PCDATA)>
<!ELEMENT date (#PCDATA)>
<!ELEMENT start-time (#PCDATA)>
<!ELEMENT end-time (#PCDATA)>
<!ELEMENT activity-name (#PCDATA)>
<!ELEMENT location-name (#PCDATA)>
<!ELEMENT trainer (name, email)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT email (#PCDATA)>

]>

<sessions export-date="<%=date%>">
  <% for (const session of sessions) {%>
  <session>
    <date><%=session.date%></date>
    <activity-name><%= session.activity.activity_name%></activity-name>
    <start-time><%=session.startTime%></start-time>
    <end-time><%=session.endTime%></end-time>
    <trainer>
      <name
        ><%= session.trainer.firstName%> <%= session.trainer.lastName%></name
      >
      <email><%= session.trainer.email%></email>
    </trainer>
    <location-name><%=session.location.location_name%></location-name>
  </session>
  <%}%>
</sessions>
